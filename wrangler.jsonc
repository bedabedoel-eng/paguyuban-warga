{
  // Cloudflare Workers (aset statis). Nama harus sama dengan nama proyek di dashboard Cloudflare.
  "name": "wargakoe",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Semua rute (mis. /ipl, /admin) dilayani index.html agar refresh halaman tidak 404.
    "not_found_handling": "single-page-application"
  }
}
